if (CMAKE_SYSTEM_NAME STREQUAL "Android" OR CMAKE_CXX_COMPILER_ID MATCHES "Clang" OR
(CMAKE_CXX_COMPILER MATCHES "android" OR CMAKE_C_COMPILER MATCHES "android") OR ANDROID)
    message(STATUS "Target build is Android")
    set(APP_TARGETS_ANDROID ON)
else ()
    set(APP_TARGETS_ANDROID OFF)
endif ()

# Global Cross-Toolchains
if (DEFINED APP_CONFIG_TARGET AND APP_CONFIG_TARGET)
    if (EXISTS "${CMAKE_SOURCE_DIR}/Toolchains/${APP_CONFIG_TARGET}.cmake")
        include("${CMAKE_SOURCE_DIR}/Toolchains/${APP_CONFIG_TARGET}.cmake")
    else ()
        message(FATAL_ERROR "Toolchain file '${APP_CONFIG_TARGET}.cmake' does not exist.\nMake sure that the Toolchain file exists.")
    endif ()
else ()
    cmake_host_system_information(RESULT HOST_ARCH QUERY OS_PLATFORM)
    cmake_host_system_information(RESULT HOST_NAME QUERY OS_NAME)

    if (HOST_ARCH MATCHES "x86_64" OR HOST_ARCH MATCHES "amd64")
        set(CMAKE_SYSTEM_PROCESSOR "x86_64")
        set(APP_SYSTEM_ARCH "x86_64")
        set(BINARY_PREFIX "x86_64")
    elseif (HOST_ARCH MATCHES "aarch64" OR HOST_ARCH MATCHES "arm64")
        set(CMAKE_SYSTEM_PROCESSOR "x86_64")
        set(APP_SYSTEM_ARCH "x86_64")
        set(BINARY_PREFIX "arm64")
    else ()
        message(FATAL_ERROR "Unsupported architecture detected, returned ${HOST_ARCH}")
    endif ()

    if (HOST_NAME MATCHES "Linux")
        set(APP_SYSTEM_TARGET "Linux")
    elseif (HOST_NAME MATCHES "Windows")
        set(APP_SYSTEM_TARGET "Windows")
    elseif (HOST_NAME MATCHES "Android")
        set(APP_SYSTEM_TARGET "Android")
        set(APP_TARGETS_ANDROID ON)
    else ()
        message(FATAL_ERROR "Unsupported OS detected, received: ${HOST_NAME}")
    endif ()
endif ()

## Force-disable Android
set(APP_TARGETS_ANDROID OFF)